{
  "name": "open-retro", "private": true, "type": "module",
  "workspaces": ["apps/*"],
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "concurrently --kill-others --names api,web 'npm run dev -w @open-retro/api' 'npm run dev -w @open-retro/web'",
    "check": "npm run check --workspaces",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {"concurrently": "^9.2.1", "typescript": "^5.9.3"}
}
